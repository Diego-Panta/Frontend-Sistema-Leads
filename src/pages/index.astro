---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Landing from '@/landing/Landing'
import { siteDescription, siteKeywords, seoOgImagePath, buildPageTitle, buildCanonicalUrl } from '@/shared/site';

const robots = ["index", "follow"];
const title = buildPageTitle();
const description = siteDescription;
const keywords = siteKeywords;
const url = buildCanonicalUrl('/');
const imageOG = seoOgImagePath;
const imagetwt = seoOgImagePath;
---

<PublicLayout {robots} {title} {description} {keywords} {url} {imageOG} {imagetwt}>
	<Landing client:load/>
</PublicLayout>
