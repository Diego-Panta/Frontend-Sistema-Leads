---
// src/crm/layouts/DashboardLayout.astro
import "@/styles/global.css";
import { siteShortName } from "@/shared/site";
import DashboardNav from '@/crm/components/DashboardNav';

export interface Props {
  title?: string;
}

const { title = `Dashboard - ${siteShortName}` } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="bg-[#F8F7F3]">
    <DashboardNav client:load />
    <main class="lg:pl-64">
      <div class="px-4 py-8 sm:px-6 lg:px-8">
        <slot />
      </div>
    </main>
  </body>
</html>